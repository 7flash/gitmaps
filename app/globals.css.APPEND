/* ──────────────────────────────────────────────────────────────────────────
   Plain JSX canvas renderer
   Append this section to app/globals.css.
   ────────────────────────────────────────────────────────────────────────── */

#canvasViewport {
  position: absolute;
  inset: 0;
  display: block;
  visibility: visible;
  opacity: 1;
  overflow: hidden;
  z-index: 4;
}

#canvasContent {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  visibility: visible;
  opacity: 1;
  transform-origin: 0 0;
  will-change: transform;
}

.plain-card {
  position: absolute;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #0f1421;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 12px;
  color: #dbe4f0;
  box-shadow: 0 18px 42px rgba(0, 0, 0, 0.22);
}

.plain-card:hover { border-color: rgba(124, 58, 237, 0.48); }
.plain-card.is-selected {
  border-color: #8b5cf6;
  box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.42), 0 20px 46px rgba(0, 0, 0, 0.34);
}

.plain-card.status-modified { border-top-color: #f59e0b; }
.plain-card.status-added { border-top-color: #22c55e; }
.plain-card.status-deleted { border-top-color: #ef4444; }
.plain-card.status-renamed { border-top-color: #60a5fa; }

.plain-card__header {
  height: 44px;
  flex: 0 0 44px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 12px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  cursor: grab;
  user-select: none;
}

.plain-card__header:active { cursor: grabbing; }

.plain-card__dot {
  height: 8px;
  width: 8px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #64748b;
}

.status-modified .plain-card__dot { background: #f59e0b; }
.status-added .plain-card__dot { background: #22c55e; }
.status-deleted .plain-card__dot { background: #ef4444; }
.status-renamed .plain-card__dot { background: #60a5fa; }

.plain-card__name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  font-weight: 600;
}

.plain-card__status {
  color: #8391a6;
  font-size: 9px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.plain-card__path {
  height: 28px;
  flex: 0 0 28px;
  box-sizing: border-box;
  padding: 8px 12px 0;
  overflow: hidden;
  color: #64748b;
  font: 10px/1.2 "JetBrains Mono", Consolas, monospace;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plain-card__body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  overflow: auto;
  overscroll-behavior: contain;
  scrollbar-gutter: stable;
  padding: 9px 12px 14px;
  cursor: text;
  user-select: text;
}

.plain-card__body pre {
  min-width: max-content;
  margin: 0;
  color: #b8c5d8;
  white-space: pre;
  tab-size: 4;
  font: 11px/1.58 "JetBrains Mono", Consolas, monospace;
}

.plain-card__message {
  padding: 13px 0;
  color: #74849a;
  font: 11px Inter, system-ui, sans-serif;
}

.plain-timeline {
  display: block;
  width: calc(100% - 12px);
  margin: 4px 6px;
  padding: 9px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #b8c5d8;
  cursor: pointer;
  text-align: left;
}

.plain-timeline:hover,
.plain-timeline.active { background: rgba(124, 58, 237, 0.16); }
.plain-timeline strong { display: block; color: #dbe4f0; font: 11px/1.3 "JetBrains Mono", monospace; }
.plain-timeline span {
  display: block;
  margin-top: 3px;
  overflow: hidden;
  color: #7d8ba2;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plain-context {
  position: fixed;
  z-index: 25000;
  min-width: 216px;
  padding: 6px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 11px;
  background: #111827;
  box-shadow: 0 22px 52px rgba(0, 0, 0, 0.47);
}

.plain-context button {
  width: 100%;
  padding: 9px 11px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #dbe4f0;
  cursor: pointer;
  text-align: left;
  font-size: 12px;
}

.plain-context button:hover { background: rgba(124, 58, 237, 0.19); }
.plain-context hr { border: 0; border-top: 1px solid rgba(148, 163, 184, 0.15); margin: 5px 2px; }

.plain-modal {
  position: fixed;
  inset: 0;
  z-index: 24000;
  display: flex;
  box-sizing: border-box;
  padding: 26px;
  background: rgba(3, 6, 13, 0.83);
  backdrop-filter: blur(8px);
}

.plain-modal__box {
  width: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 15px;
  background: #0c121f;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.42);
}

.plain-modal__header {
  height: 60px;
  flex: 0 0 60px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 17px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.13);
}

.plain-modal__heading { min-width: 0; flex: 1; }
.plain-modal__heading strong { display: block; font-size: 14px; }
.plain-modal__heading span {
  display: block;
  margin-top: 3px;
  overflow: hidden;
  color: #74849a;
  font: 11px "JetBrains Mono", monospace;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plain-modal__close {
  height: 34px;
  width: 34px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 8px;
  background: transparent;
  color: #dbe4f0;
  font-size: 19px;
  cursor: pointer;
}

.plain-preview {
  flex: 1;
  min-height: 0;
  overflow: auto;
  margin: 0;
  padding: 18px 20px;
  color: #bac8db;
  white-space: pre;
  font: 12px/1.62 "JetBrains Mono", Consolas, monospace;
}

.plain-history { flex: 1; min-height: 0; overflow: auto; }
.plain-history__grid { display: grid; width: max-content; min-width: 100%; }
.plain-history__corner,
.plain-history__head {
  position: sticky;
  top: 0;
  z-index: 4;
  height: 78px;
  box-sizing: border-box;
  padding: 13px 14px;
  border-right: 1px solid rgba(148, 163, 184, 0.12);
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  background: #111827;
}

.plain-history__corner { left: 0; z-index: 6; color: #94a3b8; font-size: 11px; }
.plain-history__head strong { display: block; font: 600 12px/1.3 "JetBrains Mono", monospace; }
.plain-history__head span,
.plain-history__head small {
  display: block;
  overflow: hidden;
  color: #74849a;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plain-history__file {
  position: sticky;
  left: 0;
  z-index: 2;
  min-height: 230px;
  box-sizing: border-box;
  padding: 14px;
  border-right: 1px solid rgba(148, 163, 184, 0.12);
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
  background: #101624;
  font-size: 12px;
}

.plain-history__file span {
  display: block;
  margin-top: 6px;
  color: #74849a;
  font: 10px/1.45 "JetBrains Mono", monospace;
  word-break: break-word;
}

.plain-history__cell {
  position: relative;
  height: 230px;
  overflow: auto;
  border-right: 1px solid rgba(148, 163, 184, 0.1);
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.plain-history__cell pre {
  min-width: max-content;
  margin: 0;
  padding: 12px;
  color: #afbdd1;
  white-space: pre;
  font: 10.5px/1.55 "JetBrains Mono", monospace;
}

.plain-history__message { padding: 16px 12px; color: #718198; font-size: 11px; }
.plain-history__changed { position: absolute; right: 9px; top: 7px; color: #8b5cf6; }

.plain-canvas-toast {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 30000;
  max-width: 430px;
  padding: 11px 14px;
  border: 1px solid rgba(124, 58, 237, 0.45);
  border-radius: 9px;
  background: #111827;
  color: #dbe4f0;
  font-size: 12px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.38);
}

.plain-canvas-toast.is-error { border-color: rgba(239, 68, 68, 0.5); }
