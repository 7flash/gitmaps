{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "server.ts", "cli.ts", "scripts/**/*.ts"]
}
